namespace: demo
clan: tolerant-ids
source-language: en-US
target-language: zh-CN

[Video Setup & Audio]
type: label

<"Save">
source: "Save"
target: "保存"
status: final

<Save & Load>
source: "Save & Load"
target: "保存并加载"
status: translated
