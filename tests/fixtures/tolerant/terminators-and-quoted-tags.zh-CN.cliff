# Tolerant fixture: the line terminator is syntax, not a repair (CLIFF 1.1 5.6),
# while a quoted tag alongside it is a repair (Appendix C.2.3).
#
# This is the shape a model actually produces: it punctuates the lines it writes
# the way prose is punctuated. The two deviations must be told apart, because a
# run that reported the terminator as a repair would inflate its own repair count
# and understate how much of an answer arrived already valid.
#
# Expected under `--tolerant`: FOUR repairs and not one more - three `tag-quote`
# (lines 27, 33, 34) plus one `list-shape` (line 34, where the same quoted tag
# also sat in a list-typed field). Not one repair comes from a `,` or a `;`;
# a run that counted those would inflate its own repair count.
# `cliff-test/tests/clarion/test_read_modes.py` asserts exactly this.
CLIFF 1.1
namespace: demo
clan: tolerant-terminators-and-quotes
source-language: en-US
target-language: zh-CN
title: "Settings strings",
info: "A model answer that punctuates every line.",

[video]
context: "Video settings screen.",
type: label,
emotion: [objective];

<resolution>
source: "Resolution"
target: "分辨率"
status: "final",
context: "Dropdown label above the resolution list.",

<fullscreen>
source: "Fullscreen"
target: "全屏"
status: "translated"
emotion: "calm",
