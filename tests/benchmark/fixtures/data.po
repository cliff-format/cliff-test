msgctxt "dialog.act3.first-meet.greeting"
msgid "你好，旅行者。"
msgstr "Hello, traveler."
#. context: The player meets Captain Mei at the city gate after the siege.
#. type: dialogue
#. emotion: polite calm
#. status: final

msgctxt "dialog.act3.first-meet.ask-origin"
msgid "你从哪里来？"
msgstr "Where do you come from?"
#. context: The player meets Captain Mei at the city gate after the siege.
#. type: dialogue
#. emotion: polite curious
#. status: reviewed

msgctxt "dialog.act3.first-meet.ask-companion"
msgid "{name}，{gender, select, male {他} female {她} other {他们}} 是你的同伴吗？"
msgstr "{name}, is {gender, select, male {he} female {she} other {they}} your companion?"
#: src/dialog/act3.cpp:87
#. context: The player meets Captain Mei at the city gate after the siege. She points at the silent stranger next to the player.
#. type: sentence
#. emotion: surprised playful
#. status: reviewed

msgctxt "dialog.act3.first-meet.ask-city"
msgid "城里还安全吗？"
msgstr "Is the city still safe?"
#. context: The player meets Captain Mei at the city gate after the siege.
#. type: dialogue
#. emotion: neutral
#. status: reviewed

msgctxt "dialog.act3.first-meet.ask-sword"
msgid "你的剑是新打的吗？"
msgstr "Was your sword newly forged?"
#. context: The player meets Captain Mei at the city gate after the siege.
#. type: dialogue
#. emotion: neutral
#. status: reviewed

msgctxt "dialog.act3.farewell.farewell"
msgid "一路顺风，旅行者！"
msgstr "Safe travels, traveler!"
#. context: The player leaves the forge with the repaired sword.
#. type: dialogue
#. emotion: playful joyful
#. status: reviewed

msgctxt "dialog.act3.farewell.farewell-pun"
msgid "剑客无剑，如鱼无水——改天我请你“剑”面！"
msgstr "A swordsman without a sword is a fish out of water - let's have a re-\"blade\" meeting soon!"
#. context: The player leaves the forge with the repaired sword. Anvil winks; the pun is on 见/剑.
#. type: dialogue
#. emotion: playful joyful
#. status: reviewed

msgctxt "dialog.act3.farewell.come-again"
msgid "下次再来！"
msgstr "Come back anytime!"
#. context: The player leaves the forge with the repaired sword.
#. type: dialogue
#. emotion: playful joyful
#. status: final

msgctxt "quests.reward.reward-title"
msgid "铁匠的谢礼"
msgstr "The Blacksmith's Gratitude"
#. context: Quest reward screen after the sword is returned.
#. type: label
#. emotion: grateful
#. status: final

msgctxt "quests.reward.reward-body"
msgid "收下这枚护符吧。"
msgstr "Please take this charm."
#. context: Quest reward screen after the sword is returned.
#. type: narration
#. emotion: grateful
#. status: reviewed

