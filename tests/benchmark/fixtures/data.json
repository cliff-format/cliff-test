      "entries": [
        {
          "id": "farewell",
          "source": "一路顺风，旅行者！",
          "target": "Safe travels, traveler!",
          "type": "dialogue",
          "status": "reviewed"
        },
        {
          "id": "farewell-pun",
          "source": "剑客无剑，如鱼无水——改天我请你“剑”面！",
          "target": "A swordsman without a sword is a fish out of water - let's have a re-\"blade\" meeting soon!",
          "type": "dialogue",
          "status": "reviewed",
          "context": "Anvil winks; the pun is on 见/剑."
        },
        {
          "id": "come-again",
          "source": "下次再来！",
          "target": "Come back anytime!",
          "type": "dialogue",
          "status": "final"
        }
      ],
