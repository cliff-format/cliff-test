  "items": {
    "ash-greets-flint": {
      "reference": "弗林特，你还欠我一把像样的刀。",
      "alternatives": [
        "弗林特，你还欠我一把像样的剑。"
      ],
      "difficulty": "normal",
      "tags": [
        "dialogue",
        "emotion",
        "naming"
      ],
      "rules": [
        {
          "id": "flint-name-phonetic",
          "kind": "name-policy",
          "params": {
            "mode": "phonetic",
            "expected": [
              "弗林特"
            ],
            "rejected": [
              "燧石",
              "打火石"
            ]
          }
        }
      ]
    },
    "flint-replies-ash": {
      "reference": "余烬，就算熔炉整个冻住，你也磨不直一块磨刀石。",
      "difficulty": "hard",
      "tags": [
        "dialogue",
        "emotion",
        "naming"
      ],
      "rules": [
        {
          "id": "ash-name-semantic",
          "kind": "name-policy",
          "params": {
            "mode": "semantic",
            "expected": [
              "余烬"
            ],
            "rejected": [
              "艾什",
              "艾许",
              "阿什"
            ]
          }
        }
      ]
    },
    "ash-fearful": {
