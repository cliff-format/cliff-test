CLIF 1.0
namespace: clarion
clan: game-quest
source-language: en-US
target-language: zh-CN
title: "Saltwake: the Ninth Light quest line"
info: "Saltwake is a seafaring adventure game set in a drowned archipelago where couriers called signal runners carry lantern messages between lighthouses. This file is the quest line 'The Ninth Light': journal briefs, objective lines, success and failure lines, item descriptions and achievement names. Audience: players on PC and handheld consoles. Objective lines are shown twice, once on the wide journal page and once in the narrow on-screen tracker, and the system strings are rendered by the game engine."
standard: "Translate the keeper's name 'Willow' semantically as 柳; never transliterate it as 薇洛, 威洛 or 维洛, and never turn it into the tree 柳树. Transliterate the quartermaster's name 'Marrow' as 马洛; never translate it as 骨髓 and never spell it 马罗. Render 'Ninth Light' identically in every entry that mentions it. Keep engine placeholders such as {playerName}, ICU MessageFormat structure and key hints such as [E] exactly as the source writes them. Use one space between Han text and Latin letters or digits, and fullwidth punctuation inside Han sentences. Avoid textbook jargon: write 稳健 rather than 鲁棒, 默认 rather than 缺省, 分辨率 rather than 解析度. Objective lines carry a display-width budget in cells, where Latin letters and digits count one cell and Han or fullwidth characters count two; the narrow version must be rewritten shorter, not truncated."

[quest.brief]
context: "Quest journal pages for the quest line 'The Ninth Light'. The player reads them between runs, so the register is unhurried and the sentences are complete."
type: description
emotion: [objective]

<brief-tide-run>
source: "The tide turns twice a day, and twice a day the harbor forgets who owes whom. Carry the sealed manifest to the quartermaster before the water rises, and the ledger stays honest for one more night."
target: "潮水一天转向两次，港口也就一天两次忘记谁欠了谁。趁涨水之前把封缄货单送到码头总管手里，账目就能再干净一晚。"
status: final
context: "Opening page of the quest journal, read after the quest is accepted. Plain narration, no character voice."

<brief-ninth-light>
source: "Nine lights ring the inner water. Eight are tended by the harbor guild; the last one stands on a rock the guild pretends not to see, and it has never once gone dark."
target: "九盏灯环绕着内海。其中八盏由港口行会照看，最后一盏立在一块行会假装看不见的礁石上，却从未熄灭过。"
status: final
context: "Second journal page, giving the player the background of the lights before the first run."

<quest-title-last-watch>
source: "Willow's Last Watch"
target: "柳的最后一班岗"
type: label
status: final
context: "Quest title shown at the top of the journal page and in the quest-accepted banner. It names the keeper of the ninth light, who is taking her final shift."

<journal-note-order>
source: "Marrow reads the manifest before he opens the gate, so objective 2 stays locked until objective 1 is signed off."
target: "马洛要先看过货单才会开闸，所以在目标 1 签收之前，目标 2 一直是锁住的。"
status: final
context: "Note printed under the objective list on the journal page. On that list the manifest delivery is the first objective and the tide gate is the second, and the numbers here must match that order."

<brief-warning-fog>
source: "Fog comes in from the west without warning. If you cannot see the next light, stop rowing and wait: the current here is patient, and sooner or later it will carry you back to the pier."
target: "雾会毫无预兆地从西边压过来。如果看不见下一盏灯，就停桨等着：这里的水流很有耐心，早晚会把你带回码头。"
status: final
context: "Safety paragraph on the journal page, written in the voice of the harbor handbook."

[quest.objectives]
context: "Objective lines for the same quest line. Every objective is written twice: once for the wide journal page and once for the narrow tracker at the edge of the screen, which is why several of them carry a width budget."
type: label
emotion: [objective]

<objective-03a>
source: "Deliver the Sealed Manifest to Marrow"
target: "把封缄货单交给马洛"
status: final
max-width: 24
context: "Objective as it appears on the wide journal page, where the full wording fits."

<objective-03b>
source: "Deliver the Sealed Manifest to Marrow"
target: "送单给马洛"
status: final
max-width: 10
context: "The same objective in the narrow on-screen tracker, where the slot is less than half as wide."

<objective-04a>
source: "Restore Power to the Tide Gate"
target: "恢复潮闸的动力供应"
status: final
max-width: 24
context: "Objective as it appears on the wide journal page, where the full wording fits."

<objective-04b>
source: "Restore Power to the Tide Gate"
target: "潮闸通电"
status: final
max-width: 10
context: "The same objective in the narrow on-screen tracker, where only a few cells are left after the checkbox."

<objective-relight>
source: "Relight the Ninth Light before the ebb"
target: "在退潮之前重新点亮第九灯"
status: final
context: "Final objective of the quest line. The lamp it names is the one the keeper and the dockhand talk about elsewhere in this file, and it must read the same way in all of them."

<objective-count-crates>
source: "{secured, plural, one {# crate secured} other {# crates secured}}"
target: "{secured, plural, other {已固定 # 个板条箱}}"
type: sentence
status: final
emotion: [mechanical]
context: "Counter under the cargo objective; the engine substitutes the number of crates already lashed down."

<objective-check-lines>
source: "Check the mooring lines on the east pier"
target: "检查东码头的系泊缆绳"
status: final
context: "Side objective on the journal page; nothing is abbreviated here."

[quest.dialogue]
context: "Voiced lines from the quest line. The keeper of the ninth light speaks slowly and plainly; the harbor quartermaster speaks in short transactional sentences. Every line is acted, so the emotion tag decides the delivery."
type: dialogue

<hail-01a>
source: "Hand me the lantern, friend."
target: "把提灯递给我吧，朋友。"
status: final
emotion: [polite, calm]
context: "The quartermaster reaches out to carry the lantern up the stair for the player; he means the offer kindly."

<hail-01b>
source: "Hand me the lantern, friend."
target: "把提灯交出来，朋友。"
status: final
emotion: [rude, angry]
context: "The same words at the top of the stair, where two of his dockhands have closed off the way back; the courtesy is a demand."

<hail-02a>
source: "Marrow says the dock is open to you."
target: "马洛说，码头随时欢迎你。"
status: final
emotion: [calm, hopeful]
context: "A dockhand passes on the quartermaster's word once the manifest has been signed; the message is a genuine welcome."

<hail-02b>
source: "Marrow says the dock is open to you."
target: "马洛放话了，码头「欢迎」你上门。"
status: final
emotion: [rude, serious]
context: "The same sentence delivered after the player has cheated him, with two dockhands waiting at the ramp; the welcome is a warning."

<dialogue-willow-keeps>
source: "Willow has kept the Ninth Light burning for eleven winters, and she has never once asked the guild for oil."
target: "柳守着第九灯，一守就是十一个冬天，从没向行会要过一次灯油。"
status: final
emotion: [calm, nostalgic]
context: "A dockhand tells the player about the keeper while they wait for the tide. The lamp he names is the one the final objective sends the player back to."

<dialogue-burn-it>
source: "Burn it before Marrow's boat reaches the pier. Cold cinders tell him nothing."
target: "在马洛的船靠上码头之前，把货单烧掉。冷掉的灰烬什么也不会告诉他。"
status: final
emotion: [urgent, anxious]
context: "Whispered by the keeper the moment the quartermaster's boat is sighted. What must be burned is the object the delivery objective puts in the player's hands, not the lamp she is standing next to."

<success-echo>
source: "The Ninth Light is yours to keep now. Do not make me regret the hand-over."
target: "从今往后，第九灯归你守。别让我后悔把它交出去。"
status: final
emotion: [serious, hopeful]
context: "The keeper's last line, spoken when the quest line is completed. It answers the sentence the dockhand used earlier about how long she kept the lamp, and should reuse that verb."

<line-success-tide>
source: "The gate holds. Whatever you did down there, the water is going where it should."
target: "闸门稳住了。不管你在下面做了什么，水都流向了它该去的地方。"
status: final
emotion: [calm, hopeful]
context: "Spoken by the gate warden when the tide-gate objective succeeds."

<line-failure-tide>
source: "The gate is jammed and the pier is under water. Come back when the tide drops and we will try again."
target: "闸门卡死了，码头已经进水。等潮水退下去再来，我们再试一次。"
status: final
emotion: [sad, calm]
context: "Spoken by the same warden when the tide-gate objective fails and the player has to retry."

[items.rewards]
context: "Item names, bag descriptions and achievement names earned along the quest line. Descriptions are read in the bag panel; achievement names appear in a banner and in the profile list."
type: description
emotion: [objective]

<item-relay-grid-desc>
source: "The relay grid is robust: one failed beacon does not break the chain."
target: "整张中继灯网很稳健：单个灯标失效也不会中断整条链路。"
status: final
context: "Bag description of the relay chart, read by players who never open an engineering manual."

<item-lamp-oil-desc>
source: "One flask feeds the lamp for 30 minutes at the default wick height."
target: "一瓶油能让灯在默认灯芯高度下燃烧 30 分钟。"
status: final
context: "Bag description of the oil flask. The wick height is the setting the lamp starts with when the player has never touched it."

<item-fog-lamp-desc>
source: "A squat brass lamp with a scratched blue shutter. The light it throws is weak, but in fog a weak light scatters less than a bright one."
target: "一盏矮胖的黄铜灯，蓝色挡片上满是划痕。它的光并不亮，可在雾里，弱光比强光更不容易散开。"
status: final
context: "Bag description of the fog lamp the player is given before the first run."

<achv-marrow-debt>
source: "Marrow's Debt"
target: "马洛的人情债"
type: label
status: final
context: "Achievement name shown in the banner when the player clears the quartermaster's account. What he owes is a favour, not money."

<achv-nine-nights>
source: "Nine Nights, Nine Lights"
target: "九夜九灯"
type: label
status: final
context: "Achievement name for visiting every lighthouse on nine consecutive in-game nights."

[system.messages]
context: "System strings shown outside the story: the loading greeting, an input hint, a status readout and the quest-state banner. Engine placeholders, ICU MessageFormat structure and key hints must survive exactly as written."
emotion: [mechanical]

<system-welcome-runner>
source: "Fair tide, {playerName}. Your last run ended 3 days ago."
target: "一路顺潮，{playerName}。你上一趟送信是在 3 天前。"
type: sentence
status: final
emotion: [calm]
context: "Greeting on the loading screen after a save is opened; the placeholder carries the player's profile name."

<system-keybind-lantern>
source: "Hold [E] to raise the lantern; press [Q] to signal."
target: "按住 [E] 键升起提灯，按 [Q] 键发信号。"
type: prompt
status: final
context: "Input hint over the lantern hook. The bracketed keys are filled in from the player's own bindings and must stay exactly as they are."

<system-signal-range>
source: "Signal range: 120 m in fog, 400 m in clear air."
target: "信号距离：雾中 120 米，晴空 400 米。"
type: sentence
status: final
context: "Status readout on the lamp panel; both distances are shown to the player as plain numbers."

<system-quest-state>
source: "{state, select, updated {Quest updated} complete {Quest complete} other {Quest failed}}"
target: "{state, select, updated {任务已更新} complete {任务完成} other {任务失败}}"
type: sentence
status: final
context: "Banner shown at the top of the screen whenever the quest state changes; the engine passes the state name."
