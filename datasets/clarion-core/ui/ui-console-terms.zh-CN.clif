CLIF 1.0
namespace: clarion
clan: ui-console-terms
source-language: en-US
target-language: zh-CN
variant: glossary
title: "Harborline Console glossary"
standard: "Canonical renderings for the Harborline Console. Terms marked final are locked and must be used exactly."

[terms]
context: "Project terminology for the ui-console file, resolved per the zh-CN house style."
type: noun
emotion: [objective]

<default>
source: "Default"
target: "默认"
status: final
context: "Initial value of a setting; use 默认, never 缺省."

<workspace>
source: "Workspace"
target: "工作区"
status: final
context: "An isolated project environment."

<stream>
source: "Stream"
target: "直播流"
status: final
context: "A live broadcast carried by the product."

<stream-key>
source: "Stream key"
target: "推流密钥"
status: final
type: noun-phrase
context: "The secret value the encoder presents to start a live stream."

<resolution>
source: "Resolution"
target: "分辨率"
status: final
context: "Output resolution of a stream; use 分辨率, never 解析度."

<frame-rate>
source: "Frame rate"
target: "帧率"
status: final
type: noun-phrase
context: "Frames per second of the output stream."

<cache>
source: "Cache"
target: "缓存"
status: final
context: "Stored responses; use 缓存, never 高速缓存."

<latency>
source: "Latency"
target: "延迟"
status: final
context: "Round-trip delay; use 延迟, never 时延."

<region>
source: "Region"
target: "区域"
status: final
context: "A geographic deployment zone."

<rate-limit>
source: "Rate limit"
target: "限流"
status: final
type: noun-phrase
context: "The ceiling on requests per second."

<token>
source: "Token"
target: "Token"
status: final
context: "Keep the Latin spelling; do not use 词元."

<api>
source: "API"
target: "API"
status: final
context: "Never translate; keep the Latin spelling."
