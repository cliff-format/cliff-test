CLIFF 1.0
namespace: clarion
clan: ui-console
source-language: en-US
target-language: zh-CN
title: "Harborline Console interface strings"
info: "Developer-facing control panel of the Harborline cloud streaming product, for product engineers operating workspaces, billing and live streams."
standard: "Follow the zh-CN house style: one space between Han text and Latin or digits, "
  "fullwidth punctuation inside Han sentences, and no textbook jargon. UI labels are "
  "short, fit their width budget, and never end with a full stop."
dependency: ["ui-console-terms.zh-CN.cliff"]

[nav]
context: "Primary navigation links in the Harborline Console sidebar."
type: label
emotion: [objective]

<billing>
source: "Billing"
target: "计费"
status: final
context: "Sidebar link that opens the invoice and payment screen."

<streaming>
source: "Streaming"
target: "流媒体"
status: final
context: "Sidebar link that opens the live stream management screen."

<workspaces>
source: "Workspaces"
target: "工作区"
status: final
context: "Sidebar link that lists the user's isolated project environments."

[billing]
context: "Billing screen: invoices, rates and usage totals."
type: label
emotion: [objective]

<billing-rate>
source: "Billing rate"
target: "计费费率"
status: final
context: "Column header in the invoice summary; the price charged per gigabyte."

<no-invoices>
source: "No invoices yet"
target: "暂无账单"
status: final
type: sentence
context: "Empty state shown when the account has never generated an invoice."

<payment-failed>
source: "Payment failed"
target: "付款失败"
status: final
type: sentence
context: "Error toast after a rejected card charge."

[streaming]
context: "Live stream management screen: sources, keys and quality settings."
type: label
emotion: [objective]

<stream-key>
source: "Stream key"
target: "推流密钥"
status: final
context: "Field that shows the secret value the encoder sends with the live stream."

<frame-rate>
source: "Frame rate"
target: "帧率"
status: final
context: "Label beside the frames-per-second selector on the quality panel."

<resolution>
source: "Resolution"
target: "分辨率"
status: final
context: "Dropdown label above the output resolution list."

<add-to-workspace>
source: "Add to workspace"
target: "加入工作区"
status: final
max-width: 10
context: "Menu action that attaches the selected stream to a project environment."

<stream-failed>
source: "Stream failed to start"
target: "推流启动失败"
status: final
type: sentence
context: "Error toast when the encoder cannot establish the live stream."

<stream-summary>
source: "{count, plural, other {# streams}} across {regions, plural, other {# regions}}"
target: "{count, plural, other {# 路直播流}}，分布于 {regions, plural, other {# 个区域}}"
status: final
type: sentence
context: "Summary line under the stream list showing how many streams run in how many regions."

[settings]
context: "Workspace settings page: region, network and cache options."
type: label
emotion: [objective]

<restore-defaults>
source: "Restore defaults"
target: "恢复默认"
status: final
max-width: 8
context: "Button that resets every option on this page to its initial value."

<clear-cache>
source: "Clear cache"
target: "清除缓存"
status: final
context: "Button that empties the stored responses so the next request reaches the origin."

<latency>
source: "Latency"
target: "延迟"
status: final
context: "Tooltip over the latency badge; the round-trip time in milliseconds."

<api-token>
source: "API token"
target: "API Token"
status: final
context: "Label of the credential field used to authenticate programmatic calls."

<request-rate-limit>
source: "Request rate limit"
target: "请求限流"
status: final
max-width: 8
context: "Field in the throttling section; the maximum requests allowed per second."

<status-line>
source: "Region: %s"
target: "区域：%s"
status: final
type: sentence
context: "Status line at the top of the page showing the currently selected region name."

<cache-description>
source: "Cached responses are kept for 24 hours and served again until they expire. "
  "Clear the cache to send every request back to the origin."
target: "缓存内容会保留 24 小时，到期前直接返回；"
  "清空缓存可让后续请求全部回源。"
status: final
type: description
context: "Explanatory paragraph under the cache options heading."

[onboarding]
context: "First-run onboarding and workspace management dialogs."
type: label
emotion: [objective]

<create-workspace>
source: "Create new workspace"
target: "新建工作区"
status: final
max-width: 10
context: "Primary button on the onboarding screen that opens the workspace creation flow."

<welcome-back>
source: "Welcome back to Harborline, {name}"
target: "欢迎回到 Harborline，{name}"
status: final
type: prompt
emotion: [polite]
context: "Greeting heading shown after sign-in, with the account holder's display name."

<workspace-count>
source: "{count, plural, one {# workspace} other {# workspaces}}"
target: "{count, plural, other {# 个工作区}}"
status: final
type: sentence
context: "Caption under the workspace list that reports the total number of project environments."

<delete-confirm>
source: "Delete this workspace? This cannot be undone."
target: "删除此工作区？此操作无法撤销。"
status: final
type: sentence
emotion: [serious]
context: "Confirmation dialog shown before permanently removing a project environment."

<close-dialog>
source: "Close dialog"
target: "关闭对话框"
status: final
type: accessibility-cue
context: "Screen-reader cue announcing the action bound to the Escape key."
