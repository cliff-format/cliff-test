          "params": {}
        }
      ]
    },
    "feature-quote": {
      "reference": "早班渡轮的船长迪娅·普劳斯说得很直白：“谁也没想到会这样。我们只是出现了，然后就开始载人。”",
      "alternatives": [],
      "difficulty": "normal",
      "tags": [
