CLIF 1.0
namespace: clarion
clan: lit-classical
source-language: zh-CN
target-language: en-US
title: "Classical literary stratum - aphorisms, parallel prose, a quatrain"
info: "Original classical Chinese composed for CLARION, to be rendered into an elevated, archaic-leaning English that keeps the register, imagery and parallel structure rather than explaining them."
standard: "Render classical Chinese into archaic-leaning literary English. Preserve parallelism and concrete imagery; do not modernise or gloss. Render coined proper nouns consistently."

[aphorisms]
type: sentence
context: "Short philosophical aphorisms from a fictional anthology, each meant to stand alone."

<water-holds>
source: "水静则清，器满则倾。"
target: "Water turns clear only when still; a vessel overfilled will tip."
status: final
emotion: [calm, serious]

<mountain-river>
source: "山不增高，因登而高；川不返流，因逝而长。"
target: "The mountain is not made taller by climbing; the river does not turn back for having flowed."
status: final
emotion: [serious, calm]

<mirror>
source: "镜不自照，故能照人；泉不自饮，故能济渴。"
target: "The mirror cannot behold itself, therefore it beholds others; the spring cannot drink itself, therefore it quenches thirst."
status: final
emotion: [calm]


<scale>
source: "尺短寸长，各有所宜。"
target: "A foot is short, an inch is long; each serves where it is fit."
status: final
emotion: [serious]

<lantern-heart>
source: "灯焰高者，其膏易尽；其光微者，其夜乃长。"
target: "The flame that burns high spends its oil quickly; the light that burns faint keeps the night long."
status: final
emotion: [nostalgic, calm]

[parallel-prose]
type: narration
context: "A short passage in the parallel-prose manner of a philosophical anthology, with balanced couplets and a recurring place name."

<parallel-prose-1>
source: "层峦千仞，藏云于顶；寒江万里，送舟于天。"
target: "As fold upon fold of crags keeps its cloud at the summit, so a cold river a thousand miles long sends the boat toward the sky."
status: final
emotion: [nostalgic, calm]

<parallel-prose-2>
source: "谷静无应，苍梧闻钟；灯微自摇，苍梧照水。"
target: "As the silent gorge returns no answer, Cangwu hears the bell; as the faint lamp trembles of itself, Cangwu casts its light upon the water."
status: final
emotion: [nostalgic, calm]

[quatrain]
type: narration
context: "A five-character quatrain about a river crossing at autumn dusk; the reference keeps quatrain form and rhyme."

<quatrain-1>
source: "渡口秋灯暗，"
target: "The ferry-lamp burns low;"
status: final
emotion: [nostalgic, sad]

<quatrain-2>
source: "江寒雨自斜。"
target: "Rain slants on the cold stream."
status: final
emotion: [nostalgic, sad]

<quatrain-3>
source: "潮回沙上字，"
target: "The tide returns whatever the river bore;"
status: final
emotion: [nostalgic, calm]

<quatrain-4>
source: "钟入隔岸家。"
target: "One bell of bronze rings from the far shore."
status: final
emotion: [nostalgic, calm]
